# Copy to .env.dev for local development. Never commit real values.
# The full reference is docs/configuration.md.
PONNOKHOJ_ENV=dev
HTTP_ADDR=:8080
METRICS_ADDR=:9090
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://ponnokhoj:CHANGE_ME@localhost:5432/ponnokhoj?sslmode=disable
APP_SECRET=CHANGE_ME_to_at_least_32_random_characters
COOKIE_SECURE=false
AUTO_VERIFY_SHOPS=false
# Demo online source (fictional shop served by ponnoKhoj itself).
SOURCES_ENABLED=demoshop
DEMO_SHOP_ENABLED=true
DEMO_SHOP_BASE_URL=http://localhost:8080/demo-shop
# Demo account passwords, read only by `ponnokhoj seed --demo`.
SEED_ADMIN_PASSWORD=CHANGE_ME_admin_password
SEED_VENDOR_PASSWORD=CHANGE_ME_vendor_password
# Optional LLM-assisted estimates (off by default). Example: local Ollama.
LLM_ENABLED=false
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=
