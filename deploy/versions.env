# Every version the local and CI toolchain pins, in one place. Read by the
# Makefile (include) and by scripts under deploy/ (source). Images are pinned
# by digest; bump tag and digest together.
#
# Checked 2026-11-10 against the upstream release pages / registries.

# Go toolchain (also in go.mod) and container base images.
GO_VERSION=1.27.4
GO_IMAGE=golang:1.27.4@sha256:08bcb99a38f85a265f9a93d1d3323e2440eec333380f3ea26ee0dec9264bb41c
RUNTIME_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329

# PostgreSQL 17 + PostGIS 3.6 (pg_trgm is contrib, included in both).
# POSTGIS_IMAGE: local compose and integration tests.
# CNPG_POSTGIS_IMAGE: CloudNativePG operand image (kind and prod).
POSTGIS_IMAGE=postgis/postgis:17-3.6@sha256:1ac10b2551ba84ae05db8e7da477afcd0a3fede99bcb7705da2ee157390cb095
CNPG_POSTGIS_IMAGE=ghcr.io/cloudnative-pg/postgis:17-3.6-standard-trixie@sha256:73593f14ce3ef6f5401a9867e6bbbcd9b8814029435d8d9dd32104458e06f769

# Local Kubernetes.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
CNPG_VERSION=1.30.1
CERT_MANAGER_VERSION=v1.21.3
# Envoy Gateway's release bundles the Gateway API CRDs it is tested with
# (v1.6.1); we install those rather than a newer upstream release
# (docs/adr/0005-gateway-api-envoy-gateway.md).
ENVOY_GATEWAY_VERSION=v1.10.0

# Linters and scanners that are not Go modules (run as pinned containers).
HADOLINT_IMAGE=hadolint/hadolint:v2.15.1@sha256:32dac94127fd60b7b7e3fbfc65e1383b9b5e25c9bfd7b8536de7a539fe68a12d
TRIVY_IMAGE=aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb

# CRD JSON schemas for kubeconform (datreeio/CRDs-catalog, pinned commit).
CRDS_CATALOG_COMMIT=49729e49e8f062933e3716a26540d41b0cd0856c

# CloudNativePG Barman Cloud plugin (prod backups only; not installed on kind).
BARMAN_CLOUD_PLUGIN_VERSION=v0.15.1
