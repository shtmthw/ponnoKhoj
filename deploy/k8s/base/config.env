# Non-secret configuration shared by every workload. Overlays merge their
# own values on top. Secrets (APP_SECRET, LLM_API_KEY, demo passwords) come
# from the ponnokhoj-secrets Secret; DATABASE_URL from the Secret that
# CloudNativePG creates for the application user (ponnokhoj-db-app).
# Reference: the configuration table in README.md.
PONNOKHOJ_ENV=dev
HTTP_ADDR=:8080
METRICS_ADDR=:9090
LOG_FORMAT=json
LOG_LEVEL=info
DB_MAX_CONNS=10
SHUTDOWN_DRAIN_DELAY=5s
SHUTDOWN_TIMEOUT=20s
COOKIE_SECURE=true
AUTO_VERIFY_SHOPS=false
SOURCES_ENABLED=
DEMO_SHOP_ENABLED=false
LLM_ENABLED=false
WORKER_CONCURRENCY=5
