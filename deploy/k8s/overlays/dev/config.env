# kind serves plain HTTP on http://localhost:8088 (and HTTPS with a
# self-signed certificate on https://localhost:8443).
PONNOKHOJ_ENV=dev
PUBLIC_BASE_URL=http://localhost:8088
COOKIE_SECURE=false
# kind's default pod network; only the gateway can reach the web pods
# (NetworkPolicy), so only its X-Forwarded-For is ever seen.
TRUSTED_PROXIES=10.244.0.0/16
# Real online shops, read through their product pages only (approved in
# docs/sources.md). Local shops are demo data.
SOURCES_ENABLED=startech,techland
DEMO_SHOP_ENABLED=false
OFFER_CACHE_TTL=6h
# AI-assisted estimates through OpenRouter (key in .env.dev as LLM_API_KEY).
# The free model takes about a minute, hence the long timeout; on failure the
# statistical estimate is used.
LLM_ENABLED=true
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TIMEOUT=150s
LLM_MAX_TOKENS=2048
LOG_LEVEL=info
# Every request to kind arrives from the one Docker bridge address, so the
# per-IP search limit is shared by every browser tab, the e2e tests and the
# load test on this machine. Raise it here; prod keeps the default of 60.
RATE_LIMIT_SEARCH_PER_MIN=12000
