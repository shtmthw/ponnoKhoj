PONNOKHOJ_ENV=prod
PUBLIC_BASE_URL=https://ponnokhoj.example.com
COOKIE_SECURE=true
# The cluster's pod network. Only the gateway can reach the web pods
# (NetworkPolicy), so only its X-Forwarded-For is honored. Narrow this to
# the real pod CIDR.
TRUSTED_PROXIES=10.0.0.0/8
SOURCES_ENABLED=
DEMO_SHOP_ENABLED=false
LLM_ENABLED=false
DB_MAX_CONNS=15
